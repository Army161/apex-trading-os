# Apex Trading OS: every variable in one place. Copy to .env and fill in locally.
# Never paste keys into chat. Every bot defaults to paper/test mode.

# --- Dashboard (Vercel project env vars) ---
APEX_ADMIN_PASSWORD=          # password for the control buttons (kill switch, bot commands)
APEX_INGEST_TOKEN=            # shared secret bots send in the x-apex-token header
ANTHROPIC_API_KEY=            # Apex AI chat, strategy builder, assistants, research council
APEX_CHAT_MODEL=claude-opus-5-5
UPSTASH_REDIS_REST_URL=       # optional; without it state lives in memory and resets on redeploy
UPSTASH_REDIS_REST_TOKEN=

# Telegram bot for the dashboard (alerts + /positions /orders /pnl /strategies /bots)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=      # any random string; pass it as secret_token when you call setWebhook
CRON_SECRET=                  # Vercel Cron sends it; protects /api/cron/*
DISCORD_WEBHOOK_URL=          # optional: briefs also go to a Discord channel
APEX_MIN_RR=3                 # Risk Mitigator minimum reward:risk (shorts need +0.5)
APEX_AI_DAILY_BUDGET=5        # USD/day estimate: Telegram alert at 1x, AI pauses at 2x. Also set a limit in the Anthropic Console.
APEX_REVIEW_MODEL=claude-fable-5-2   # model for the owner/engineer/QA review before a live flag (~$0.40-0.60 a review)
FRED_API_KEY=                 # optional, free from fred.stlouisfed.org, powers the macro panel
# ALPACA_API_KEY_ID / ALPACA_API_SECRET_KEY in Vercel too if you want stocks in Deal Seeker (paper keys are enough)

# --- Every bot ---
APEX_DASHBOARD_URL=https://<your-deployment>.vercel.app
APEX_ALLOW_LIVE=no            # must be exactly "yes" (plus each bot's own live flag) to touch real money
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# --- Alpaca (nightly ETF system + day trader desk) ---
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_LIVE=no
SEC_USER_AGENT="ApexResearch contact@example.com"   # SEC EDGAR requires a contact; use a generic one
MASSIVE_API_KEY=              # optional market data

# --- Research council ---
APEX_ANALYST_MODEL=claude-sonnet-5-5
APEX_JUDGE_MODEL=claude-opus-5-5

# --- Polymarket copy bot (bots/polymarket-copy/.env) ---
MODE=paper
TARGET_WALLET=
ORDER_TYPE=FOK
PRIVATE_KEY=                  # only for MODE=live
RPC_URL=https://polygon-rpc.com
POLYMARKET_GEO_TOKEN=

# --- Solana copy bot (bots/solana-copy/.env; full list in its .env.example) ---
# MODE=paper, TARGET_WALLETS=, RPC_URL=, PRIVATE_KEY= (live only)

# --- Maker/Sky clip keeper ---
ETH_RPC_URL=
KEEPER_PRIVATE_KEY=           # only for --live

# --- Freqtrade (docker-compose reads these) ---
BINANCE_BASE=

# --- Autopilot (paper). Used by the apex command line and the nightly GitHub Action ---
DATABASE_URL=                 # Postgres (Supabase). Without it the ledger is a file in APEX_STATE_DIR, which is also durable
APEX_STATE_DIR=               # where the file ledger, refreshed bars and reports live. Default: .apex in the repo
APEX_PAPER_CAPITAL=10000      # paper book starting equity
APEX_RISK_PCT=1               # risk per trade, percent of equity. Ceiling 2. A looser value takes effect after 24 hours
APEX_MAX_WEIGHT_PCT=25        # largest share of equity one slot may hold. No leverage
APEX_MAX_CLASS_PCT=60         # largest share of open risk in one asset class
APEX_MAX_CORR_RISK_PCT=2      # largest open risk across highly correlated symbols, percent of equity
APEX_COOLDOWN_BARS=1          # bars to wait after a stop-out
APEX_TRIALS_PER_WEEK=25       # new strategy and market pairs the factory may start by itself each week
APEX_LEDGER_ANCHOR=git        # git | git+ots | off
APEX_VALIDATOR_SOURCE=        # second data source for the validator (alpaca), once its terms are accepted in data/SOURCES.md
APEX_RECEIPTS_PUBLIC=no
MASSIVE_API_KEY=              # market data only. It cannot trade, so it may be a GitHub Actions secret
TELEGRAM_CHAT_ID=             # with TELEGRAM_BOT_TOKEN: where the short daily report is sent
TIINGO_API_KEY=               # long daily history. Not used until its terms are accepted
APEX_API_URL=                 # CLI remote mode, MCP and extension (client side). Not built yet
APEX_API_KEY=
APEX_API_KEYS_PEPPER=         # server side, for hashing API keys. Not built yet
APEX_STORAGE_URL=             # object storage for reports and exports. Not built yet
APEX_STORAGE_KEY=
# APEX_SIGNOFF_KEY belongs only on Jeremy's own machine. Never on Vercel, GitHub or in a cloud session, so it has no line here.
# No key that can trade is ever set on Vercel or in GitHub. Live trading runs only from the executor on Jeremy's machine.
