# MODE=paper simulates fills against the live order book and never signs anything. MODE=live needs PRIVATE_KEY.
MODE=paper
TARGET_WALLET=0xTARGET_WALLET_TO_COPY
# Only for MODE=live. Use a fresh wallet holding only what you are willing to lose. Never commit this file.
PRIVATE_KEY=
RPC_URL=https://polygon-rpc.com
POLYMARKET_GEO_TOKEN=
POSITION_MULTIPLIER=0.1
MAX_TRADE_SIZE=5
MIN_TRADE_SIZE=1
SLIPPAGE_TOLERANCE=0.02
ORDER_TYPE=FOK
COPY_SELLS=false
MAX_SESSION_NOTIONAL=50
MAX_PER_MARKET_NOTIONAL=10
MIN_PRICE=0.05
MAX_PRICE=0.95
POLL_INTERVAL=2000
USE_WEBSOCKET=true
PAPER_BANKROLL=500
APEX_DASHBOARD_URL=
APEX_INGEST_TOKEN=
