# Solana copy bot. PAPER is the default. Live needs MODE=live AND APEX_ALLOW_LIVE=yes AND a private key set here, never in chat.
MODE=paper
# Comma-separated wallets to copy. Score them first: npm run score -- <wallet>
TARGET_WALLETS=
RPC_URL=https://api.mainnet-beta.solana.com
PRIVATE_KEY=                 # base58 secret key, only for MODE=live; use a fresh hot wallet with small funds

# Sizing (video: fixed 1 SOL or 50% ratio). Defaults here are deliberately small.
SIZE_MODE=fixed              # fixed | ratio
FIXED_SOL=0.05
RATIO=0.5
MAX_SOL_PER_TRADE=0.1
MAX_OPEN_POSITIONS=5
MAX_DAILY_LOSS_SOL=0.25
PAPER_BANKROLL_SOL=2

# Trade settings from the video
SLIPPAGE_PCT=35
PRIORITY_FEE_SOL=0.001
JITO_TIP_SOL=0.001
COPY_SELLS=true
LAUNCHPADS=pump,bonk         # only tokens from these launchpads (mint suffix / dex id)
MIN_MCAP_USD=10000
MAX_MCAP_USD=0               # 0 = no cap
MIN_TOKEN_AGE_MIN=0
MAX_TOKEN_AGE_MIN=0          # 0 = no cap
NO_DUPLICATE_BUYS=true

# Exits from the video: sell 80% at 2x (20% moon bag), then a trailing stop locked 20% into profit
TP_LADDER=2:0.8              # multiple:fraction pairs, e.g. 2:0.5,4:0.25
TRAIL_TRIGGER_X=2            # once price reaches 2x entry...
TRAIL_LOCK_PCT=20            # ...the stop moves to +20% over entry
TRAIL_PCT=35                 # and then trails 35% below the highest price seen
STOP_LOSS_PCT=50             # hard stop the video doesn't mention; memecoins can go to zero

# Anti-PVP: stop copying a wallet that flips tokens quickly (farming copy traders)
PVP_FLIP_SECONDS=60
PVP_MAX_FLIPS=3              # flips inside the window below before the wallet is muted
PVP_WINDOW_MIN=30

POLL_MS=3000
APEX_DASHBOARD_URL=
APEX_INGEST_TOKEN=
