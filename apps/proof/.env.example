# Proof (working name): the claim checker as a service. docs/design/12-saas-product.md
# This app has its own Vercel project, database, model key and data licence. It shares no setting with the personal Apex
# app: lib/env.ts refuses to run if any variable from the root .env.example is present here. The one shared NAME is
# ANTHROPIC_API_KEY, and its value must be a different key. Never put a real value in this file.

# internal (default), beta or paid. Moving to paid is Jeremy's decision.
PROOF_STAGE=
# The public address of this deployment. https only.
PROOF_BASE_URL=

# Proof's own Supabase project (from P5.2). The service role key is used only by the billing webhook and the workers.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# A Postgres connection string to the same Supabase database (from P5.3). The server and the workers use it, and every
# statement first takes the signed-in person's role or the workers' role. Never the personal app's DATABASE_URL.
PROOF_DATABASE_URL=

# Proof's own model key and spend caps in USD a day (from P5.3).
ANTHROPIC_API_KEY=
PROOF_AI_ACCOUNT_DAILY_USD=
PROOF_AI_GLOBAL_DAILY_USD=

# Market data under a commercial licence (DATA_LICENCE.md). Never the personal data key.
PROOF_DATA_API_KEY=

# Proof's own Redis for rate limits, queues and locks.
PROOF_REDIS_REST_URL=
PROOF_REDIS_REST_TOKEN=

# Stripe (from P5.4). A test-mode key until the stage is paid: a live key is refused before that.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
